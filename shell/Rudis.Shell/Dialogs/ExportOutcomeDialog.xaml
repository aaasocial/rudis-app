<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Rudis.Shell.Dialogs.ExportOutcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Calibri"
    RequestedTheme="Dark"
    Background="{StaticResource bg-panel}"
    Foreground="{StaticResource text-primary}"
    BorderBrush="{StaticResource border-hairline}"
    BorderThickness="1"
    CornerRadius="{StaticResource radius-panel}"
    AutomationProperties.AutomationId="Export.Outcome.Dialog"
    AutomationProperties.Name="Export outcome">

    <!--
      Debug session `export-no-file-written` (2026-08-01): the Toolbar's export
      previously surfaced NOTHING on completion — success and failure both looked
      like the busy fill clearing, and the only record was App.LogDiagnostic's
      in-memory ring. This dialog is the visible outcome for the Export button
      path: SUCCESS shows the real written path (selectable, with a
      Show-in-folder affordance); FAILURE shows the engine's error verbatim on
      the same bg-elevated error treatment ExportDialog.ErrorSurface uses (no
      red/danger token exists in the handoff). The two states set different
      titles and different content visibility, so they are visually
      distinguishable at a glance — that indistinguishability was the defect.

      Follows ExportDialog.xaml's conventions exactly: an in-app ContentDialog
      (same XamlRoot popup layer), tokens only ({StaticResource} keys from
      Theme/Tokens.xaml — a raw hex literal here is a build FAILURE), its OWN
      buttons (never ContentDialog's template parts, so the AutomationIds can be
      declared here), and the sync-handler-starting-a-Task event pattern (the
      shell's `async void` grep must stay at zero).
    -->

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogForeground" ResourceKey="text-primary" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="border-hairline" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="border-hairline" />

        <!-- Outlined (Show in folder) — ExportDialog's DialogOutlinedButtonStyle,
             repeated because ContentDialog.Resources do not cross dialogs. -->
        <Style x:Key="OutcomeOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource border-strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-segment-active}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brand fill (Close) — ExportDialog's DialogAccentButtonStyle. -->
        <Style x:Key="OutcomeAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource accent}" />
            <Setter Property="Foreground" Value="{StaticResource on-accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="18,0,18,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <Border Background="{StaticResource bg-panel}"
            Padding="20,18,20,18"
            CornerRadius="{StaticResource radius-panel}"
            AutomationProperties.AutomationId="Export.Outcome.Surface"
            AutomationProperties.Name="Export outcome surface"
            AutomationProperties.AccessibilityView="Content">
        <StackPanel Width="400" Spacing="14">

            <TextBlock x:Name="TitleText"
                       Text="Export complete"
                       Foreground="{StaticResource text-primary}"
                       FontSize="17"
                       FontWeight="Bold"
                       AutomationProperties.AutomationId="Export.Outcome.Title" />

            <!-- SUCCESS: the real written path, selectable so it can be copied. -->
            <StackPanel x:Name="SuccessPanel">
                <TextBlock Text="Saved to" Foreground="{StaticResource text-secondary}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <!-- No explicit AutomationProperties.Name: a TextBlock's UIA Name
                     defaults to its Text, and the PATH is the content a screen
                     reader (or the UIA verification) needs to read. -->
                <TextBlock x:Name="PathText"
                           Foreground="{StaticResource text-primary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="Export.Outcome.Path" />
            </StackPanel>

            <!-- FAILURE: the engine's error verbatim, on ExportDialog's error
                 treatment (bg-elevated + text-secondary — the handoff defines no
                 red/danger token). -->
            <Border x:Name="ErrorSurface"
                    Visibility="Collapsed"
                    Background="{StaticResource bg-elevated}"
                    CornerRadius="{StaticResource radius-control}"
                    Padding="10,8,10,8">
                <!-- Same rule as Export.Outcome.Path: the ERROR text is the content. -->
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource text-secondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="Export.Outcome.Error" />
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button x:Name="ShowInFolderButton"
                        Content="Show in folder"
                        Style="{StaticResource OutcomeOutlinedButtonStyle}"
                        Click="OnShowInFolderClick"
                        AutomationProperties.AutomationId="Export.Outcome.ShowInFolder"
                        AutomationProperties.Name="Show in folder" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{StaticResource OutcomeAccentButtonStyle}"
                        Click="OnCloseClick"
                        AutomationProperties.AutomationId="Export.Outcome.Close"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
