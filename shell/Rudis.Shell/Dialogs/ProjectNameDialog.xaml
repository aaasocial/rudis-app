<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Rudis.Shell.Dialogs.ProjectNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Calibri"
    RequestedTheme="Dark"
    Background="{StaticResource bg-panel}"
    Foreground="{StaticResource text-primary}"
    BorderBrush="{StaticResource border-hairline}"
    BorderThickness="1"
    CornerRadius="{StaticResource radius-panel}"
    AutomationProperties.AutomationId="ProjectName.Dialog"
    AutomationProperties.Name="New project">

    <!--
      Toolbar.Project.New's name prompt (plan 60.1-05).

      Styled identically to ExportDialog and RemoveTrackDialog, which is the shell's
      established rule for its modals; every colour, radius and metric is a
      {StaticResource} token key (CLAUDE.md rule 7) and a raw hex literal here is a
      build FAILURE (MechanicalGatesTests.no_raw_hex_outside_the_token_dictionary).

      ═══ WHY THERE IS NO VALIDATION IN THIS FILE, OR IN ITS CODE-BEHIND ═══

      `sanitize_project_name` (T-26-01) owns what a project may be called, INCLUDING
      the Windows reserved-device-name refusal ("NUL", "COM1", ...) that a
      from-scratch validator misses and that a user would otherwise meet as a
      filesystem error much later. So this dialog sends whatever was typed - not
      trimmed, not filtered, not length-checked - and renders the engine's refusal.
      A second rule set in the shell is exactly the drift the don't-hand-roll rule
      exists to prevent.

      ═══ A REFUSAL KEEPS THE DIALOG OPEN ═══

      ExportDialog.OnConfirmClick's shape, deliberately reused: the reason appears
      INSIDE the dialog and the name the user typed is still there to edit. Closing
      on failure would make the user retype it to find out what was wrong.

      ═══ THE THIRD OF SC-1's CASES ═══

      Like the export and remove-track dialogs, this renders in the XamlRoot's popup
      layer - the same visual tree as the Preview region's SwapChainPanel - and so
      composites above it with no occluder machinery at all.
    -->

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogForeground" ResourceKey="text-primary" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="border-hairline" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="border-hairline" />

        <Style x:Key="ProjectFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource text-secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ProjectOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource border-strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-segment-active}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource accent}" />
            <Setter Property="Foreground" Value="{StaticResource on-accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="18,0,18,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <!-- The surface Border carries its OWN AutomationId, for the reason ExportDialog
         and RemoveTrackDialog both record: a ContentDialog's automation peer reports
         the WHOLE XamlRoot as its BoundingRectangle, so a layering proof cropped to it
         would be measuring the entire window. This Border is the real surface. Its id
         deliberately avoids the `ProjectName.Dialog` prefix so a mechanical count of
         that prefix stays at the four controls (root, name box, error, buttons). -->
    <Border Background="{StaticResource bg-panel}"
            Padding="20,18,20,18"
            CornerRadius="{StaticResource radius-panel}"
            AutomationProperties.AutomationId="ProjectName.Surface"
            AutomationProperties.Name="New project dialog surface"
            AutomationProperties.AccessibilityView="Content">
        <StackPanel Width="400" Spacing="16">

            <TextBlock Text="New project"
                       Foreground="{StaticResource text-primary}"
                       FontSize="17"
                       FontWeight="Bold" />

            <StackPanel>
                <TextBlock Text="Project name" Style="{StaticResource ProjectFieldLabelStyle}" />
                <TextBox x:Name="NameBox"
                         PlaceholderText="Coastline Reel"
                         KeyDown="OnNameKeyDown"
                         TextChanged="OnNameChanged"
                         AutomationProperties.AutomationId="ProjectName.Dialog.Name"
                         AutomationProperties.Name="Project name" />
            </StackPanel>

            <!-- A refusal must be VISIBLE, never swallowed (50-05's rule, UI-SPEC
                 section 5). No red/danger token exists in the handoff, so this uses
                 the same `text-secondary` on `bg-elevated` treatment ExportDialog and
                 Preview.ErrorState use.

                 ⚠ NO AutomationProperties.Name on the TextBlock, deliberately - the
                 RemoveTrackDialog finding: a TextBlock's UIA Name defaults to its own
                 TEXT, and an explicit Name OVERRIDES it, so a screen reader would
                 announce the label instead of the reason. The reason IS the point. -->
            <Border x:Name="ErrorSurface"
                    Visibility="Collapsed"
                    Background="{StaticResource bg-elevated}"
                    CornerRadius="{StaticResource radius-control}"
                    Padding="10,8,10,8">
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource text-secondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ProjectName.Dialog.Error" />
            </Border>

            <!-- The dialog's OWN buttons, for the reason ExportDialog records:
                 ContentDialog's primary/close buttons are template parts and cannot
                 carry a declared AutomationId in this file. Esc dismisses and is
                 treated as Cancel. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ProjectOutlinedButtonStyle}"
                        Click="OnCancelClick"
                        AutomationProperties.AutomationId="ProjectName.Dialog.Cancel"
                        AutomationProperties.Name="Cancel" />
                <Button x:Name="ConfirmButton"
                        Content="Create"
                        Style="{StaticResource ProjectAccentButtonStyle}"
                        Click="OnConfirmClick"
                        AutomationProperties.AutomationId="ProjectName.Dialog.Confirm"
                        AutomationProperties.Name="Create project" />
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
