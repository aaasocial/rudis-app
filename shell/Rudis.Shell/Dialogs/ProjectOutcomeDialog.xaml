<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Rudis.Shell.Dialogs.ProjectOutcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Calibri"
    RequestedTheme="Dark"
    Background="{StaticResource bg-panel}"
    Foreground="{StaticResource text-primary}"
    BorderBrush="{StaticResource border-hairline}"
    BorderThickness="1"
    CornerRadius="{StaticResource radius-panel}"
    AutomationProperties.AutomationId="ProjectOutcome.Dialog"
    AutomationProperties.Name="Project">

    <!--
      The project lifecycle's VISIBLE refusal (plan 60.1-05).

      ═══ WHY IT EXISTS AT ALL ═══

      Debug session `export-no-file-written` (2026-08-01) is the precedent and the
      warning: before ExportOutcomeDialog, a completed export surfaced NOTHING, and the
      only record was App.LogDiagnostic's in-memory ring - bounded, unpersisted,
      invisible. Three real exports were reported by the owner as "no file written"
      while the engine had been healthy the whole time. Open / Save / Save As are the
      same shape of operation with the same failure mode, so their refusals get the
      same treatment: the engine's reason, on screen, in the user's way.

      This surface is REFUSALS ONLY. Success is deliberately silent: the backend emits
      ProjectSwitched, the mirror full-resyncs and the TitleBar picks up the new name,
      so a modal saying "saved" would be a click between a beginner and their work for
      information the window already shows.

      Every colour is a {StaticResource} token key (CLAUDE.md rule 7); a raw hex
      literal here is a build FAILURE.
    -->

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogForeground" ResourceKey="text-primary" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="border-hairline" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="border-hairline" />

        <Style x:Key="OutcomeOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource border-strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-segment-active}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <!-- The surface Border carries its own AutomationId, and deliberately not the
         `ProjectOutcome.Dialog` prefix - see ExportDialog.xaml and RemoveTrackDialog.xaml
         for the full reasoning (a ContentDialog's own peer reports the whole XamlRoot). -->
    <Border Background="{StaticResource bg-panel}"
            Padding="20,18,20,18"
            CornerRadius="{StaticResource radius-panel}"
            AutomationProperties.AutomationId="ProjectOutcome.Surface"
            AutomationProperties.Name="Project outcome dialog surface"
            AutomationProperties.AccessibilityView="Content">
        <StackPanel Width="420" Spacing="16">

            <TextBlock x:Name="TitleText"
                       Foreground="{StaticResource text-primary}"
                       FontSize="17"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ProjectOutcome.Dialog.Title" />

            <!-- The engine's own sentence, trimmed of serde's wrapper for the screen
                 (D-60.1-05) while the raw string goes to the diagnostic log.

                 ⚠ NO AutomationProperties.Name here, for RemoveTrackDialog's recorded
                 reason: a TextBlock's UIA Name defaults to its TEXT and an explicit
                 Name overrides it, so a screen reader would read a label instead of
                 the reason. The reason IS the mitigation. -->
            <Border Background="{StaticResource bg-elevated}"
                    CornerRadius="{StaticResource radius-control}"
                    Padding="10,8,10,8">
                <TextBlock x:Name="ReasonText"
                           Foreground="{StaticResource text-secondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="ProjectOutcome.Dialog.Reason" />
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{StaticResource OutcomeOutlinedButtonStyle}"
                        Click="OnCloseClick"
                        AutomationProperties.AutomationId="ProjectOutcome.Dialog.Close"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
