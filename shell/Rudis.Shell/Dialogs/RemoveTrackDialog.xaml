<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Rudis.Shell.Dialogs.RemoveTrackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Calibri"
    RequestedTheme="Dark"
    Background="{StaticResource bg-panel}"
    Foreground="{StaticResource text-primary}"
    BorderBrush="{StaticResource border-hairline}"
    BorderThickness="1"
    CornerRadius="{StaticResource radius-panel}"
    AutomationProperties.AutomationId="RemoveTrack.Dialog"
    AutomationProperties.Name="Remove track">

    <!--
      v6.0's `#remove-track-dialog` (frontend/index.html:697-712), ported. v6 styles it
      IDENTICALLY to its export dialog on purpose (main.ts:1191: "the
      #remove-track-dialog modal styled like #export-dialog"), so this file mirrors
      ExportDialog.xaml's surface, hairline, radius and button styles exactly.

      ═══ WHAT THE CONFIRMATION IS GUARDING ═══

      `Command::RemoveTrack { index }` removes the lane UNCONDITIONALLY and CASCADES —
      every clip on it goes with it (crates/core/src/command.rs:2177-2196). Its inverse
      is `RestoreTrack`, which carries the FULL removed track (kind + the entire clip
      Vec), so the removal is an EXACT structural restore on undo (T-18.1-04). That is
      why the wording names the kind AND the clip count: the count is the part of the
      cascade the user cannot see from the button they pressed. T-51-23.

      ═══ SECOND OF SC-1's THREE CASES ═══

      Like the export dialog, this renders in the XamlRoot's popup layer — the same
      visual tree as the Preview region's SwapChainPanel — and therefore composites
      ABOVE it with no occluder machinery of any kind. Under the retired Tauri
      SetWindowRgn hole-punch this exact dialog was one of the three cases that stayed
      visually broken (research/v7-SUMMARY.md "Conflict 2").

      Every colour is a {StaticResource} token key (CLAUDE.md rule 7); a raw hex
      literal here is a build FAILURE.
    -->

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogForeground" ResourceKey="text-primary" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="border-hairline" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="border-hairline" />

        <Style x:Key="ConfirmOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource border-strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-segment-active}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource accent}" />
            <Setter Property="Foreground" Value="{StaticResource on-accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="18,0,18,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <!-- ⚠ The surface Border carries its own AutomationId for the reason
         ExportDialog.xaml records in full: a `ContentDialog`'s own automation peer
         reports the WHOLE XamlRoot as its BoundingRectangle, so a layering proof that
         cropped to it would be measuring the entire window. This Border is the real
         surface and is what such a proof must crop to.

         ⚠ AND ITS NAME IS DELIBERATELY NOT THE OBVIOUS ONE. This plan's acceptance
         criterion counts the lines in this file matching an id prefix of the form
         `RemoveTrack` + `.Dialog`, and expects exactly four (root, message, confirm,
         cancel). Naming this element with that prefix would make it five and quietly
         break a mechanical criterion to satisfy a naming habit — so it is
         `RemoveTrack.Surface`. The mechanical criterion wins; the precedent is plans
         51-01 and 51-05, each of which resolved the same collision the same way. -->
    <Border Background="{StaticResource bg-panel}"
            Padding="20,18,20,18"
            CornerRadius="{StaticResource radius-panel}"
            AutomationProperties.AutomationId="RemoveTrack.Surface"
            AutomationProperties.Name="Remove track dialog surface"
            AutomationProperties.AccessibilityView="Content">
        <StackPanel Width="400" Spacing="16">

            <TextBlock Text="Remove track"
                       Foreground="{StaticResource text-primary}"
                       FontSize="17"
                       FontWeight="Bold" />

            <!-- Populated at open with the track's kind and clip count, in v6's own
                 wording (main.ts `confirmRemoveTrack`), read rather than invented.

                 ⚠ NO AutomationProperties.Name, deliberately. A TextBlock's UIA Name
                 defaults to its own TEXT, and an explicit Name OVERRIDES it — the first
                 draft set one and a screen reader (and plan 51-06's artifact, which
                 quotes this element through UIA) got the label "Remove track message"
                 instead of the sentence naming what the cascade will take. The message
                 IS the mitigation; it has to be the thing that is read out. -->
            <TextBlock x:Name="MessageText"
                       Foreground="{StaticResource text-secondary}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="RemoveTrack.Dialog.Message" />

            <!-- The dialog's OWN buttons, for the reason ExportDialog.xaml records:
                 ContentDialog's primary/close buttons are template parts and cannot
                 carry a declared AutomationId in this file. v6's markup likewise
                 carries #remove-track-cancel / #remove-track-confirm inside the
                 dialog element. Esc dismisses and is treated as Cancel. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ConfirmOutlinedButtonStyle}"
                        Click="OnCancelClick"
                        AutomationProperties.AutomationId="RemoveTrack.Dialog.Cancel"
                        AutomationProperties.Name="Cancel" />
                <Button x:Name="ConfirmButton"
                        Content="Remove"
                        Style="{StaticResource ConfirmAccentButtonStyle}"
                        Click="OnConfirmClick"
                        AutomationProperties.AutomationId="RemoveTrack.Dialog.Confirm"
                        AutomationProperties.Name="Remove" />
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
