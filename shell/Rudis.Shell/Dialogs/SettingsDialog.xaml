<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Rudis.Shell.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Calibri"
    RequestedTheme="Dark"
    Background="{StaticResource bg-panel}"
    Foreground="{StaticResource text-primary}"
    BorderBrush="{StaticResource border-hairline}"
    BorderThickness="1"
    CornerRadius="{StaticResource radius-panel}"
    AutomationProperties.AutomationId="Settings.Dialog"
    AutomationProperties.Name="Settings">

    <!--
      Phase 69 (OSS-01, D-69-10/11): the ONE key surface. Reached from the TitleBar app
      menu (Settings…), Ctrl+, and the Chat KeyButton - all three route through
      MainWindow.ShowSettingsAsync. The inline Chat key form it replaces is retired, so
      there are not two key surfaces that can drift.

      Two provider sections, IDENTICAL in shape (Anthropic, Runway): label, status line,
      masked PasswordBox (no reveal), Save/Replace, Clear (only when stored in Credential
      Manager), a verbatim backend error and a get-a-key hint.

      ExportDialog's pattern throughout: an in-app ContentDialog (same visual tree as the
      Preview SwapChainPanel), the dialog's OWN buttons (never the template's
      Primary/Close parts, whose AutomationIds cannot be declared here), and TOKENS ONLY -
      MechanicalGatesTests.no_raw_hex_outside_the_token_dictionary scans this file.
    -->

    <ContentDialog.Resources>
        <!-- The stock ContentDialog template reads these keys. Aliasing them onto
             design tokens is how the surface, its hairline and its command area obey
             CLAUDE.md rule 7 without a single literal. -->
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogForeground" ResourceKey="text-primary" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="border-hairline" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="bg-panel" />
        <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="border-hairline" />

        <!-- Field label (handoff Typography: small, `text-secondary`). -->
        <Style x:Key="DialogFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource text-secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Outlined (Cancel / Browse) — the same resolution Toolbar.xaml records
             for `ToolbarOutlinedButtonStyle`: outlined `border-strong`, hover fill
             `bg-elevated` (UI-SPEC gap 2). -->
        <Style x:Key="DialogOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource border-strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-segment-active}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brand fill (the confirm action) — `accent` fill, `on-accent` text,
             hover `accent-bright`, exactly as Toolbar.ExportButton. -->
        <Style x:Key="DialogAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource accent}" />
            <Setter Property="Foreground" Value="{StaticResource on-accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-control}" />
            <Setter Property="Padding" Value="18,0,18,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource accent-bright}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource on-accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource accent-bright}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource bg-elevated}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource text-tertiary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <!-- The real surface carries its own AutomationId: the ContentDialog peer reports
         the whole XamlRoot as its bounds (see ExportDialog.xaml). -->
    <Border Background="{StaticResource bg-panel}"
            Padding="20,18,20,18"
            CornerRadius="{StaticResource radius-panel}"
            AutomationProperties.AutomationId="Settings.Dialog.Surface"
            AutomationProperties.Name="Settings dialog surface"
            AutomationProperties.AccessibilityView="Content">
        <StackPanel Width="400" Spacing="18">

            <TextBlock Text="Settings"
                       Foreground="{StaticResource text-primary}"
                       FontSize="17"
                       FontWeight="Bold" />

            <!-- ═══ Anthropic ═══ the agent (rudis_set_api_key / rudis_clear_api_key, unchanged). -->
            <StackPanel Spacing="6">
                <TextBlock Text="Anthropic API key" Style="{StaticResource DialogFieldLabelStyle}" />

                <!-- Text AND UIA Name are set together in code from AgentStatusText.Describe
                     (D-69-15): exactly `connected`, `connected (from environment variable -
                     developer setup)` or `unavailable - no API key - add one in Settings`. -->
                <TextBlock x:Name="AnthropicStatus"
                           Foreground="{StaticResource text-secondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Settings.Anthropic.Status" />

                <!-- Masked, NO reveal button (T-69-21): the masked proof cannot be
                     defeated by a toggle. Never populated from stored data - the stored
                     key never comes back over the ABI at all; Replace means type a new one. -->
                <PasswordBox x:Name="AnthropicKeyInput"
                             PasswordRevealMode="Hidden"
                             PlaceholderText="sk-ant-..."
                             FontSize="12"
                             CornerRadius="{StaticResource radius-control}"
                             AutomationProperties.AutomationId="Settings.Anthropic.KeyInput"
                             AutomationProperties.Name="Anthropic API key" />

                <!-- The backend's refusal, VERBATIM (the ExportDialog error treatment). -->
                <Border x:Name="AnthropicErrorSurface"
                        Visibility="Collapsed"
                        Background="{StaticResource bg-elevated}"
                        CornerRadius="{StaticResource radius-control}"
                        Padding="10,8,10,8">
                    <TextBlock x:Name="AnthropicError"
                               Foreground="{StaticResource text-secondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Settings.Anthropic.Error"
                               AutomationProperties.Name="Anthropic key error" />
                </Border>

                <TextBlock Text="No key yet? Get one at console.anthropic.com/settings/keys"
                           Foreground="{StaticResource text-tertiary}"
                           FontSize="10"
                           TextWrapping="Wrap" />

                <Grid>
                    <!-- Visible only when the key is stored in Credential Manager: a key
                         from the environment cannot be cleared from here. -->
                    <Button x:Name="AnthropicClear"
                            Content="Clear"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DialogOutlinedButtonStyle}"
                            Click="OnAnthropicClearClick"
                            AutomationProperties.AutomationId="Settings.Anthropic.Clear"
                            AutomationProperties.Name="Clear Anthropic key" />
                    <Button x:Name="AnthropicSave"
                            Content="Save"
                            HorizontalAlignment="Right"
                            Style="{StaticResource DialogAccentButtonStyle}"
                            Click="OnAnthropicSaveClick"
                            ToolTipService.ToolTip="Saving stores the key in Windows Credential Manager; it takes precedence over the environment variable"
                            AutomationProperties.AutomationId="Settings.Anthropic.Save"
                            AutomationProperties.Name="Save Anthropic key" />
                </Grid>
            </StackPanel>

            <!-- ═══ Runway ═══ generation (rudis_set_provider_key / rudis_clear_provider_key, provider runway - D-69-12). -->
            <StackPanel Spacing="6">
                <TextBlock Text="Runway API key" Style="{StaticResource DialogFieldLabelStyle}" />

                <!-- Text AND UIA Name are set together in code from AgentStatusText.Describe
                     (D-69-15): exactly `connected`, `connected (from environment variable -
                     developer setup)` or `unavailable - no API key - add one in Settings`. -->
                <TextBlock x:Name="RunwayStatus"
                           Foreground="{StaticResource text-secondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Settings.Runway.Status" />

                <!-- Masked, NO reveal button (T-69-21): the masked proof cannot be
                     defeated by a toggle. Never populated from stored data - the stored
                     key never comes back over the ABI at all; Replace means type a new one. -->
                <PasswordBox x:Name="RunwayKeyInput"
                             PasswordRevealMode="Hidden"
                             PlaceholderText="Runway API key"
                             FontSize="12"
                             CornerRadius="{StaticResource radius-control}"
                             AutomationProperties.AutomationId="Settings.Runway.KeyInput"
                             AutomationProperties.Name="Runway API key" />

                <!-- The backend's refusal, VERBATIM (the ExportDialog error treatment). -->
                <Border x:Name="RunwayErrorSurface"
                        Visibility="Collapsed"
                        Background="{StaticResource bg-elevated}"
                        CornerRadius="{StaticResource radius-control}"
                        Padding="10,8,10,8">
                    <TextBlock x:Name="RunwayError"
                               Foreground="{StaticResource text-secondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Settings.Runway.Error"
                               AutomationProperties.Name="Runway key error" />
                </Border>

                <TextBlock Text="No key yet? Get one at dev.runwayml.com"
                           Foreground="{StaticResource text-tertiary}"
                           FontSize="10"
                           TextWrapping="Wrap" />

                <Grid>
                    <!-- Visible only when the key is stored in Credential Manager: a key
                         from the environment cannot be cleared from here. -->
                    <Button x:Name="RunwayClear"
                            Content="Clear"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DialogOutlinedButtonStyle}"
                            Click="OnRunwayClearClick"
                            AutomationProperties.AutomationId="Settings.Runway.Clear"
                            AutomationProperties.Name="Clear Runway key" />
                    <Button x:Name="RunwaySave"
                            Content="Save"
                            HorizontalAlignment="Right"
                            Style="{StaticResource DialogAccentButtonStyle}"
                            Click="OnRunwaySaveClick"
                            ToolTipService.ToolTip="Saving stores the key in Windows Credential Manager; it takes precedence over the environment variable"
                            AutomationProperties.AutomationId="Settings.Runway.Save"
                            AutomationProperties.Name="Save Runway key" />
                </Grid>
            </StackPanel>

            <TextBlock Text="Keys are stored in Windows Credential Manager. Nothing is written to a file."
                       Foreground="{StaticResource text-tertiary}"
                       FontSize="10"
                       TextWrapping="Wrap" />

            <Button x:Name="CloseDialogButton"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogOutlinedButtonStyle}"
                    Click="OnCloseClick"
                    AutomationProperties.AutomationId="Settings.Dialog.Close"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </Border>
</ContentDialog>
